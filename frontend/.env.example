# Frontend environment variables.
# Copy to `.env.local` for local development.

# Server-side only. Where Next.js (`rewrites()` in next.config.ts) proxies
# /api/* requests at runtime. Keep the backend internal — only the Next.js
# server needs to reach it.
BACKEND_URL=http://localhost:8999

# Client-side override. Leave empty so the browser uses same-origin (/api/...)
# and benefits from the proxy + zero-CORS setup. Only set this if you know
# what you are doing — the URL must be reachable from end-user browsers.
NEXT_PUBLIC_API_URL=
